# MySQL 8 Database Configuration (do not commit real secrets)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobconnect
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
# Optional full JDBC URL for Cloud SQL Auth Proxy on Cloud Run:
# DB_URL=jdbc:mysql:///jobconnect?cloudSqlInstance=PROJECT_ID:REGION:INSTANCE_NAME&socketFactory=com.google.cloud.sql.mysql.SocketFactory&createDatabaseIfNotExist=true&serverTimezone=UTC

# JWT Configuration (use a strong >= 32-byte Base64 secret in production)
JWT_SECRET=replace-with-a-secure-256-bit-base64-encoded-secret-key-for-production
JWT_EXPIRATION_MS=86400000
JWT_COOKIE_NAME=jobconnect_jwt
# Local dev: false / Lax | Cloud Run HTTPS cross-origin: true / None
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional explicit redirect URI override (defaults to {baseUrl}/login/oauth2/code/google):
# GOOGLE_REDIRECT_URI=https://your-backend-service.run.app/login/oauth2/code/google

# Frontend Redirect & CORS Origins
# Local Vite dev: http://localhost:5173 | Cloud Run / AI Studio: https://your-frontend-origin.run.app
FRONTEND_URL=http://localhost:5173
APP_FRONTEND_AUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage (local dev path; Cloud Run prod profile defaults to /tmp/jobconnect/resumes)
APP_UPLOAD_DIR=./storage/resumes
PORT=8080
